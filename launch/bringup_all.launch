<launch>
    <!-- 1. Bring up robot base -->
    <include file="$(find jupiterobot2_bringup)/launch/jupiterobot2_bringup.launch"/>

    <!-- 2. Launch predefined map -->
    <!-- MODIFY map_file value at wait_and_launch_navigation.sh to your own map -->
    <node pkg="bvi_fyp" type="wait_and_launch_navigation.sh" name="navigation_launcher" output="screen"/>

    <!-- 3. Bring up both camera -->
    <include file="$(find robotedge_jupiter_vision)/launch/multi_astra.launch"/>

    <!-- 4. Bring up camera & arm motor -->
    <node pkg="robotedge_jupiter_general" type="wait_and_launch_arm.sh" name="arm_launcher" output="screen"/>

    <!-- 5. Once everything is ready, run move_it -->
    <node pkg="robotedge_jupiter_general" type="wait_and_launch_move_it.sh" name="move_it_launcher" output="screen"/>


    <!-- 4. Bring up camera & arm motor -->
    <!-- <include file="$(find jupiterobot2_bringup)/launch/arm_head_bringup.launch"/> -->

    <!-- 5. Bring up arm move_it -->
    <!-- <include file="$(find jupiterobot2_bringup)/launch/moveit_bringup.launch"/> -->
</launch>